# ACKSTREET AGENT — environment template
#
# Copy to .env and fill in. The CLI does not load .env automatically (that keeps
# the runtime dependency-free); export the values, or use a tool such as direnv:
#
#   set -a && source .env && set +a
#   ackstreet doctor
#
# Every ACKSTREET_* variable below overrides the matching config.toml key.

# ---------------------------------------------------------------------------
# Agent behaviour  ->  [agent]
# ---------------------------------------------------------------------------
ACKSTREET_AGENT_PROVIDER=openai
ACKSTREET_AGENT_MODEL=
ACKSTREET_AGENT_MAX_STEPS=25
ACKSTREET_AGENT_TEMPERATURE=0.2
ACKSTREET_AGENT_AUTO_CURATE=true

# ---------------------------------------------------------------------------
# Approval gate  ->  [agent]
# ---------------------------------------------------------------------------
# auto      = dangerous tools run without asking (default)
# ask       = every dangerous tool call needs an explicit yes
# allowlist = calls matching ACKSTREET_AGENT_APPROVAL_ALLOWLIST run, the rest ask
ACKSTREET_AGENT_APPROVAL_MODE=auto

# JSON list of allow/deny rules. Grammar:
#   ls                  bare name  -> that tool, or a shell command starting with it
#   git status*         glob       -> matching shell commands
#   read_file:docs/*    tool:glob  -> that tool, when its target matches
ACKSTREET_AGENT_APPROVAL_ALLOWLIST=[]
# Refused in EVERY mode, even "auto", and even against a human yes.
ACKSTREET_AGENT_APPROVAL_DENYLIST=[]

# ---------------------------------------------------------------------------
# State location
# ---------------------------------------------------------------------------
# Where config, skills, memory and the workspace live. Defaults to ~/.ackstreet
# ACKSTREET_HOME=/home/you/.ackstreet
# ACKSTREET_CONFIG=/home/you/.ackstreet/config.toml

# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------
# Set only the one you actually use.

# OpenAI (or Azure / OpenRouter / Groq / Together / DeepSeek — anything
# OpenAI-compatible; change providers.<name>.base_url in the config too).
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# A generic key for a self-hosted OpenAI-compatible server (vLLM, LM Studio,
# llama.cpp). Ollama itself needs no key.
CUSTOM_API_KEY=

# ---------------------------------------------------------------------------
# Web search (optional)
# ---------------------------------------------------------------------------
# web_search works without these using a keyless DuckDuckGo fallback, but a
# real backend gives much better results. First configured one wins:
#   Tavily -> Serper -> Brave -> DuckDuckGo
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# TLS (optional)
# ---------------------------------------------------------------------------
# Point at a custom CA bundle when behind a corporate proxy or TLS-inspecting
# network. The standard SSL_CERT_FILE / REQUESTS_CA_BUNDLE variables are also
# honoured automatically.
# ACKSTREET_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem

# ---------------------------------------------------------------------------
# Tool switches  ->  [tools]
# ---------------------------------------------------------------------------
ACKSTREET_TOOLS_ALLOW_SHELL=true
ACKSTREET_TOOLS_ALLOW_WEB=true
ACKSTREET_TOOLS_ALLOW_PYTHON=true
ACKSTREET_TOOLS_SHELL_TIMEOUT=60

# ---------------------------------------------------------------------------
# Memory  ->  [memory]
# ---------------------------------------------------------------------------
ACKSTREET_MEMORY_ENABLED=true

# ---------------------------------------------------------------------------
# Skills  ->  [skills]
# ---------------------------------------------------------------------------
ACKSTREET_SKILLS_ENABLED=true

# ---------------------------------------------------------------------------
# Chat connectors  ->  [connectors]
# ---------------------------------------------------------------------------
# Telegram bot token from @BotFather. Storing it here (or in the config file)
# is optional -- `ackstreet connect telegram --token ...` writes the config.
# ACKSTREET_TELEGRAM_BOT_TOKEN=123456789:AAE...xyz
# TELEGRAM_BOT_TOKEN=123456789:AAE...xyz

# Where the WhatsApp multi-device session (and therefore the login) is kept.
# Default: <ACKSTREET home>/whatsapp/session.db
# ACKSTREET_WHATSAPP_SESSION=/home/you/.ackstreet/whatsapp/session.db

# SECURITY: empty allowlists mean ANYONE who can message the bot can run the
# agent on this machine, including shell commands. Set explicit user ids, or
# "*" to allow everyone deliberately. `/whoami` in the chat reveals your id.
ACKSTREET_CONNECTORS_ALLOWED_USER_IDS=[]
ACKSTREET_CONNECTORS_ALLOW_GROUP_CHATS=false
ACKSTREET_CONNECTORS_SESSION_TTL=3600
# How long to wait for a yes/no answer before refusing the action.
ACKSTREET_CONNECTORS_APPROVAL_TIMEOUT=300
